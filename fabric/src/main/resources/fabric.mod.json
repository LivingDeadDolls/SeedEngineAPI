{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}+${minecraft_version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/LivingDeadDolls/SeedEngineAPI",
        "issues": "https://github.com/LivingDeadDolls/SeedEngineAPI/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "seedengine.SeedEngineFabric"
        ],
        "client": [
            "seedengine.SeedEngineFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "${fabric_minecraft_dependency}",
        "fabric-api": "*",
        "java": ">=${java_version}"
    }
}
